# Copy this file to `.env` in the same folder and fill in real values.
# NEVER commit `.env` (it is gitignored). Rotate any credential that leaks.

# --- Required: Neon (or any Postgres) connection string ---
# From the Neon console: Connection string. Keep sslmode=require.
# The server strips an unsupported channel_binding flag and upgrades to verify-full automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint-pooler.region.aws.neon.tech/DBNAME?sslmode=require

# --- Server bind (behind Nginx, keep it loopback-only) ---
PORT=8080
HOST=127.0.0.1

# --- Optional: Postgres pool size ---
PG_POOL_MAX=10

# --- Used ONLY by `node setup-neon.mjs` to create/update the founder admin ---
# Leave ADMIN_PASSWORD empty to skip; the seeded placeholder admin remains until you set it.
ADMIN_PHONE=775784158
ADMIN_NAME=RWAMIGABO Innocent
ADMIN_PASSWORD=
