# Nginx site for Citymarket Dakar on citymarketbusiness.shop
# Place at /etc/nginx/sites-available/citymarket.conf, symlink into sites-enabled,
# then:  sudo nginx -t && sudo systemctl reload nginx
#
# Nginx serves the built frontend (dist/) directly and reverse-proxies the API
# (/functions/...) to the Node server on 127.0.0.1:8080.
# Adjust APP_DIR if you deploy somewhere other than /var/www/citymarket.

# HTTP: answer Let's Encrypt challenges, redirect everything else to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name citymarketbusiness.shop www.citymarketbusiness.shop;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS: static frontend + API proxy.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name citymarketbusiness.shop www.citymarketbusiness.shop;

    # Filled in by certbot (see DEPLOY-HOSTINGER.md). If you run `certbot --nginx`
    # it will add these lines for you automatically.
    ssl_certificate     /etc/letsencrypt/live/citymarketbusiness.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/citymarketbusiness.shop/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /var/www/citymarket/dist;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;

    client_max_body_size 2m;

    # API -> Node server (the only dynamic part).
    location /functions/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Hashed build assets: cache aggressively.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: any unknown route loads index.html (client router takes over).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
